<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <TextView android:id="@+id/title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/login_title" android:textColor="@color/accent"
        android:textSize="44sp" android:textStyle="bold" android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="80dp"/>

    <TextView android:id="@+id/sub"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/login_sub" android:textColor="@color/text_dim"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/keyWrap" android:layout_width="0dp" android:layout_height="wrap_content"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:layout_constraintTop_toBottomOf="@id/sub"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/keyInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="XXXX-XXXX-XXXX-XXXX" android:textColor="@color/text_light"
            android:textColorHint="@color/text_dim" android:inputType="textVisiblePassword" android:maxLines="1"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Button android:id="@+id/loginBtn" android:layout_width="0dp" android:layout_height="56dp"
        android:text="@string/login_btn" android:backgroundTint="@color/accent"
        android:textColor="@color/text_light"
        app:layout_constraintTop_toBottomOf="@id/keyWrap"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp"
        android:visibility="gone" android:indeterminateTint="@color/accent"
        app:layout_constraintTop_toBottomOf="@id/loginBtn"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text_dim" android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/progress"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
